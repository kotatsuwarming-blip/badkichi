{
  "name": "badkichi",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build --dotenv .env.production",
    "build:dev": "nuxt build --dotenv .env.development",
    "dev": "nuxt dev --dotenv .env.development",
    "preview": "nuxt preview --dotenv .env.production",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "lint:actions": "actionlint .github/workflows/",
    "typecheck": "nuxt typecheck --dotenv .env.development",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "db:types": "set -a && . .env.development && set +a && supabase gen types typescript --project-id $SUPABASE_PROJECT_REF > app/types/supabase.ts"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.122",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/supabase": "^2.0.9",
    "@sentry/nuxt": "^10.69.0",
    "echarts": "^6.1.0",
    "nuxt": "^4.5.2",
    "posthog-js": "^1.414.0",
    "tailwindcss": "^4.2.1",
    "vue-echarts": "^8.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.1.0",
    "@supabase/supabase-js": "^2.112.2",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.8.1",
    "happy-dom": "^20.11.2",
    "lint-staged": "^17.3.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm test && pnpm i18n:check && ./scripts/check-migration-integrity.sh pre-commit"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix"
    ]
  },
  "pnpm": {
    "overrides": {
      "fontless>esbuild": "^0.28.1",
      "@eslint/config-inspector>esbuild": "^0.28.1",
      "vue": "3.5.32",
      "@vue/compiler-core": "3.5.32",
      "@vue/compiler-dom": "3.5.32",
      "@vue/compiler-sfc": "3.5.32",
      "@vue/compiler-ssr": "3.5.32",
      "@vue/reactivity": "3.5.32",
      "@vue/runtime-core": "3.5.32",
      "@vue/runtime-dom": "3.5.32",
      "@vue/server-renderer": "3.5.32",
      "@vue/shared": "3.5.32"
    }
  },
  "packageManager": "pnpm@10.32.1"
}
