# 統合テスト (test:integration) 用の環境変数テンプレート。
# 実体ファイル `.env.test` を作る場合は `.env.test.example` をコピーして使う。
# ただし `NUXT_SUPABASE_SECRET_KEY` は .env.test にも絶対に書かない (strict secret policy)。

# dev プロジェクトの URL (Supabase Cloud)
NUXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# 新 API キー (publishable)。読み取り専用、クライアントから参照される
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxx

# テストユーザの email (任意。未設定なら test-a@example.com / test-b@example.com)
TEST_USER_A_EMAIL=test-a@example.com
TEST_USER_B_EMAIL=test-b@example.com

# ⚠️ NUXT_SUPABASE_SECRET_KEY (sb_secret_*) は .env.test に絶対に書かない方針です (strict secret policy)。
#
# ローカル実行時はシェル env で都度渡す:
#   NUXT_SUPABASE_SECRET_KEY=sb_secret_xxx pnpm test:integration
#
# CI (GitHub Actions) では Secrets から環境変数として注入する。
# ファイルに書くと git 履歴や bash history への漏洩リスクが上がるため不採用。
