# Supabase クライアント設定（ブラウザに露出する。publishable key は RLS で保護）
# 値は Supabase Dashboard → Project Settings → API から取得する
NUXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxx...

# Supabase CLI で pnpm db:types を実行する際の Project Ref (公開情報。URL の左部分)
# ローカル開発者は `supabase login` で keychain に access token を保存しておく
SUPABASE_PROJECT_REF=xxxxxxxxxxxxxxxxxxxx

# ⚠️ NUXT_SUPABASE_SECRET_KEY (sb_secret_*) は .env.* に書かない方針です。
# パスワードマネージャに保管し、必要な時のみシェル env で渡します:
#
#   NUXT_SUPABASE_SECRET_KEY=sb_secret_xxx pnpm migrate
#
# 漏洩リスク (バックアップ / IDE 同期 / 誤コミット) を最小化するためです。

# Sentry エラー監視 (error-handling.md §8.3)
# DSN は public key のため空値で記載 (実際の値は Sentry Dashboard → Project Settings → Client Keys から取得)
NUXT_PUBLIC_SENTRY_DSN=
# 環境ラベル: development / staging / prd (prd デプロイ時は CI で NUXT_PUBLIC_ENV=prd を設定)
NUXT_PUBLIC_ENV=development

# PostHog 計測基盤 (ADR-016)
# key は publishable な公開鍵 (ブラウザ露出前提) のため secret 扱いしない。空値なら計測 no-op。
# 値は PostHog Dashboard → Project Settings → Project API Key / region から取得
NUXT_PUBLIC_POSTHOG_KEY=
# リージョンで決まる: US=https://us.i.posthog.com / EU=https://eu.i.posthog.com
NUXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# 作者・ドッグフーディング用アカウントのメール (カンマ区切り)。一致ユーザーは計測から除外。
NUXT_PUBLIC_POSTHOG_EXCLUDE_EMAILS=
